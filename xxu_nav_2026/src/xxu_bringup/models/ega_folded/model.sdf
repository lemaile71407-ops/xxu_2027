      <sensor name="RGLLidar_livox_lidar_housing" type="custom">
        <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
          <range>
            <min>0.1</min>
            <max>40</max>
          </range>
          <update_rate>10</update_rate>
          <update_on_paused_sim>false</update_on_paused_sim>
          <topic>/rm_sim/lidar/points</topic>
          <frame>livox_lidar</frame>
          <pattern_preset>Livox Mid360</pattern_preset>
        </plugin>
        <pose>0 0 0.0210828934311 0 0 3.14159265359</pose>
      </sensor>
      <sensor name="livox_lidar_housing_imu" type="imu">
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <topic>/livox/imu</topic>
        <frame>livox_lidar_imu</frame>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>

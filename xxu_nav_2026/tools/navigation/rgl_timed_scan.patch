+bool RGLServerPluginInstance::PrepareTimedLidar(
+    const gz::sim::EntityComponentManager& ecm, std::chrono::steady_clock::duration simTime)
+{
+    const auto current = FindWorldPose(thisLidarEntity, ecm);
+    const auto duration = simTime - previousPoseTime;
+    const double seconds = std::chrono::duration<double>(duration).count();
+    if (!havePreviousPose || seconds <= 0.0 || seconds > 0.5) {
+        previousPose = current;
+        previousPoseTime = simTime;
+        lastRaytraceTime = simTime;
+        havePreviousPose = true;
+        return false;
+    }
+    const auto linear = previousPose.Rot().RotateVectorReverse((current.Pos() - previousPose.Pos()) / seconds);
+    auto rotation = previousPose.Rot().Inverse() * current.Rot();
+    if (rotation.W() < 0) rotation = gz::math::Quaterniond(-rotation.W(), -rotation.X(), -rotation.Y(), -rotation.Z());
+    gz::math::Vector3d axis;
+    double angle = 0;
+    rotation.AxisAngle(axis, angle);
+    const auto angular = axis * (angle / seconds);
+    const rgl_vec3f v{{static_cast<float>(linear.X()), static_cast<float>(linear.Y()), static_cast<float>(linear.Z())}};
+    const rgl_vec3f w{{static_cast<float>(angular.X()), static_cast<float>(angular.Y()), static_cast<float>(angular.Z())}};
+    for (size_t i = 0; i < rayTimeOffsetsMs.size(); ++i)
+        rayTimeOffsetsMs[i] = static_cast<float>(seconds * 1000.0 * i / rayTimeOffsetsMs.size());
+    auto lidarToWorld = IgnPose3dToRglMatrix(previousPose);
+    auto worldToLidar = IgnPose3dToRglMatrix(previousPose.Inverse());
+    if (!CheckRGL(rgl_node_rays_set_time_offsets(&rglNodeSetTimeOffsets, rayTimeOffsetsMs.data(), rayTimeOffsetsMs.size())) ||
+        !CheckRGL(rgl_node_raytrace_configure_velocity(rglNodeRaytrace, &v, &w)) ||
+        !CheckRGL(rgl_node_rays_transform(&rglNodeLidarPose, &lidarToWorld)) ||
+        !CheckRGL(rgl_node_points_transform(&rglNodeToLidarFrame, &worldToLidar))) return false;
+    scanStartTime = previousPoseTime;
+    previousPose = current;
+    previousPoseTime = simTime;
+    return true;
+}
